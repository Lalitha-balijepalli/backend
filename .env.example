# Copy to .env for local dev. On Railway/Render, set these as dashboard env vars instead.

# Injected automatically by Railway/Render at runtime - do not hardcode in production.
PORT=8000

# REQUIRED. Powers both transcription (app/services/whisper_service.py) and
# emotion detection (app/services/emotion_service.py) via the Gemini API.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=AQ.Ab8RN6LHBdihGrxIIvsOgww0HnrM8Jg6If5IgacGNfS298QdSg

# Optional - defaults to gemini-3.6-flash if unset (see gemini_client.py for
# why; check https://ai.google.dev/gemini-api/docs/models if this 404s later).
GEMINI_MODEL=gemini-3.6-flash

SUPABASE_URL=
SUPABASE_KEY=
