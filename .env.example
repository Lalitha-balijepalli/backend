# Copy to .env for local dev. On Railway/Render, set these as dashboard env vars instead.

# Injected automatically by Railway/Render at runtime - do not hardcode in production.
PORT=8000

# REQUIRED. Powers both transcription (app/services/whisper_service.py) and
# emotion detection (app/services/emotion_service.py) via the Groq API.
# Free key at https://console.groq.com/keys - no credit card required.
GROQ_API_KEY=

# Optional overrides - see app/services/groq_client.py for defaults and
# what to do if a model name gets retired.
GROQ_TRANSCRIBE_MODEL=whisper-large-v3
GROQ_VISION_MODEL=qwen/qwen3.6-27b

SUPABASE_URL=
SUPABASE_KEY=
