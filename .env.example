# Copy to .env for local dev. On Railway/Render, set these as dashboard env vars instead.

# Injected automatically by Railway/Render at runtime - do not hardcode in production.
PORT=8000

# Whisper model size. "base" is a good speed/accuracy/memory tradeoff.
# Options: tiny, base, small, medium, large  (larger = more accurate, more RAM/CPU, slower first call)
WHISPER_MODEL=base

# Only needed once these are actually wired into backend routes.
GEMINI_API_KEY=
SUPABASE_URL=
SUPABASE_KEY=
